{
  "manifest_version": 3,
  "name": "Plex Catalog",
  "version": "0.1.0",
  "description": "Export your Plex media library to XLSX, PDF, DOCX, RTF, TXT, or XML",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["*://localhost:32400/*", "*://127.0.0.1:32400/*"],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Plex Catalog",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  }
}
