{
  "manifest_version": 3,
  "name": "Plex Catalog",
  "version": "0.1.0",
  "description": "Export your Plex media library to XLSX, PDF, DOCX, RTF, TXT, or XML",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:32400/*"],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Plex Catalog"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  }
}
